{
  "manifest_version": 3,
  "name": "NakliOS Browser",
  "version": "0.2.0",
  "description": "Shows sites inside the NakliOS desktop for light browsing, without your sign-ins. Removes framing headers only inside the NakliOS tab.",
  "minimum_chrome_version": "128",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "declarativeNetRequestWithHostAccess",
    "webNavigation",
    "storage"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://naklios.dev/*"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://naklios.dev/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "frame.html",
        "frame.js",
        "frame.css",
        "lib.mjs"
      ],
      "matches": [
        "https://naklios.dev/*"
      ]
    }
  ]
}
