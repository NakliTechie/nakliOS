{
  "accepts": [
    {
      "action": "import",
      "label": "Add to Notes",
      "extensions": [
        ".md",
        ".markdown",
        ".txt"
      ]
    }
  ],
  "widgets": [
    {
      "id": "list",
      "title": "Latest list",
      "display": "list"
    }
  ],
  "commands": [
    {
      "name": "list.add",
      "description": "Add items to a list in the Notes app, e.g. \"add milk and eggs to my shopping list\". Creates the list if it is new.",
      "scope": "write",
      "input": {
        "type": "object",
        "properties": {
          "list": {
            "type": "string",
            "minLength": 1,
            "description": "List name, e.g. \"shopping\""
          },
          "things": {
            "type": "string",
            "minLength": 1,
            "description": "The things to add, separated by commas or \"and\""
          }
        },
        "required": [
          "list",
          "things"
        ]
      }
    },
    {
      "name": "list.read",
      "description": "Read a list from the Notes app, e.g. \"what is on my shopping list\".",
      "scope": "read",
      "input": {
        "type": "object",
        "properties": {
          "list": {
            "type": "string",
            "minLength": 1,
            "description": "List name"
          }
        },
        "required": [
          "list"
        ]
      }
    },
    {
      "name": "note.create",
      "description": "Write a new note in the Notes app, e.g. \"make a note that the plumber comes on Tuesday\".",
      "scope": "write",
      "input": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "A short title"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "description": "The note"
          }
        },
        "required": [
          "text"
        ]
      }
    },
    {
      "name": "note.update",
      "description": "Change a note in the Notes app: its text, its title, or its notebook, e.g. \"rename my trip note to Goa\".",
      "scope": "write",
      "input": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "description": "The note's title"
          },
          "new_title": {
            "type": "string"
          },
          "text": {
            "type": "string",
            "description": "The whole new text"
          },
          "notebook": {
            "type": "string",
            "description": "The notebook to move it to"
          }
        },
        "required": [
          "title"
        ]
      }
    },
    {
      "name": "note.pin",
      "description": "Pin or unpin a note in the Notes app, e.g. \"pin my trip note\".",
      "scope": "write",
      "input": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "pinned": {
            "type": "boolean"
          }
        },
        "required": [
          "title"
        ]
      }
    },
    {
      "name": "note.trash",
      "description": "Move a note in the Notes app to Recently Deleted, e.g. \"delete my trip note\".",
      "scope": "destructive",
      "input": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "title"
        ]
      }
    },
    {
      "name": "notebook.create",
      "description": "Make a new notebook in the Notes app, e.g. \"make a notebook called Work\".",
      "scope": "write",
      "input": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name"
        ]
      }
    }
  ],
  "parity": {
    "search": "view",
    "new-note": "note.create",
    "new-notebook": "notebook.create",
    "mobile-back": "view",
    "notebook-select": "note.update",
    "pin-note": "note.pin",
    "trash-note": "note.trash",
    "note-title": "note.update",
    "note-body": "note.update",
    "remote-change": "view",
    "text-dialog-input": "notebook.create",
    "confirm-dialog-cancel": "view",
    "confirm-dialog-keep": "view",
    "confirm-dialog-ok": "person: deleting forever from Recently Deleted stays the person's act"
  }
}
