          "offset": {
            "type": "integer",
            "description": "First result to return (default 0)",
            "minimum": 0
          },
          "limit": {
            "type": "integer",
            "description": "Results per page (default 20)",
            "minimum": 1,
            "maximum": 100
          }
        },
        "required": [
