    {
      "name": "smart.create",
      "label": "New smart playlist",
      "description": "Save a smart playlist rule as <name>.nakliamp-smart.json in the music folder. Rules match all or any; each is { field, op, value }.",
      "scope": "write",
      "approval": "reversible",
      "group": "playlist",
      "input": {
        "type": "object",
        "properties": {
          "rule": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "Name",
                "minLength": 1,
                "maxLength": 120
              },
              "match": {
                "type": "string",
                "enum": [
                  "all",
                  "any"
                ],
                "description": "Match all rules or any rule"
              },
              "rules": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "field": {
                      "type": "string",
                      "enum": [
                        "genre",
                        "artist",
                        "albumArtist",
                        "album",
                        "title",
                        "year",
                        "rating",
                        "playCount",
                        "lastPlayedAt",
                        "addedAt",
                        "durationS",
                        "path",
                        "favourite"
                      ],
                      "description": "Field"
                    },
                    "op": {
                      "type": "string",
                      "enum": [
                        "is",
                        "is-not",
                        "contains",
                        "not-contains",
                        "gt",
                        "lt",
                        "between",
                        "in-last-days",
                        "not-in-last-days"
                      ],
                      "description": "Operator"
                    },
                    "value": {
                      "description": "Value: text, number, or [low, high] for between"
                    }
                  },
                  "required": [
                    "field",
                    "op"
                  ],
                  "additionalProperties": false
                },
                "description": "Rules"
              },
              "limit": {
                "type": "integer",
                "description": "Most tracks to include",
                "minimum": 1,
                "maximum": 10000
              },
              "sort": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string",
                    "enum": [
                      "title",
                      "artist",
                      "album",
                      "year",
                      "addedAt",
                      "playCount",
                      "lastPlayedAt",
                      "rating",
                      "durationS"
                    ],
                    "description": "Sort key"
                  },
                  "direction": {
                    "type": "string",
                    "enum": [
                      "asc",
                      "desc"
                    ],
                    "description": "Direction"
                  }
                },
                "required": [],
                "additionalProperties": false
              }
            },
            "required": [
              "name",
              "match",
              "rules"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "rule"
        ],
        "additionalProperties": false
