{
  "commands": [
    {
      "name": "library.open",
      "label": "Open Library",
      "description": "Show the photo library (the grid of every photo in the added folders).",
      "scope": "read",
      "input": {
        "type": "object",
        "properties": {},
        "required": []
      },
      "shortcut": "Ctrl+L",
      "shows": true
    },
    {
      "name": "library.stats",
      "label": "Library stats",
      "description": "Count photos, videos, favourites, hidden, trashed, albums and folders in the library, and report background job progress.",
      "scope": "read",
      "input": {
        "type": "object",
        "properties": {},
        "required": []
      }
    },
    {
      "name": "library.roots",
      "label": "Library folders",
      "description": "List the folders added to the library, with their ids and photo counts.",
      "scope": "read",
      "input": {
        "type": "object",
        "properties": {},
        "required": []
      }
    },
    {
      "name": "library.search",
      "label": "Search photos",
      "description": "Find photos by words, date range, album, folder, camera, tag, favourite, rating or flag. Returns ids and short details, a page at a time.",
      "scope": "read",
      "input": {
        "type": "object",
        "properties": {
          "q": {
            "type": "string",
            "description": "words to match in file name, folder, tags, album names, camera; a year (2024) or month name (March) matches capture dates"
          },
          "from": {
            "type": "string",
            "description": "capture date on or after, YYYY-MM-DD"
          },
          "to": {
            "type": "string",
            "description": "capture date before, YYYY-MM-DD"
          },
          "kind": {
            "type": "string",
            "enum": [
              "photo",
              "video"
            ]
          },
          "album": {
            "type": "string",
            "description": "album id from album.list"
          },
          "folder": {
            "type": "string",
            "description": "folder path inside its root, e.g. \"2024/Goa\""
          },
          "root": {
            "type": "string",
            "description": "root id from library.roots"
          },
          "camera": {
            "type": "string"
          },
          "tag": {
            "type": "string",
            "description": "a tag; a parent tag matches its children"
          },
          "fav": {
            "type": "boolean",
            "description": "only favourites"
          },
          "minRating": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "flag": {
            "type": "string",
            "enum": [
              "pick",
              "reject",
              "none"
            ]
          },
          "hidden": {
            "type": "string",
            "enum": [
              "exclude",
              "only",
              "include"
            ],
            "description": "default exclude"
          },
          "trashed": {
            "type": "string",
            "enum": [
              "exclude",
              "only",
              "include"
            ],
            "description": "default exclude"
          },
          "sort": {
            "type": "string",
            "enum": [
              "time-desc",
              "time-asc",
              "name",
              "size"
            ]
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500,
            "description": "default 50, at most 500"
          },
          "cursor": {
            "type": "string",
            "description": "from a previous result, to get the next page"
          }
        },
        "required": []
      },
      "shortcut": "/"
    },
    {
      "name": "library.rescan",
      "label": "Rescan folders",
      "description": "Look for new, changed and missing files in one added folder, or all of them.",
      "scope": "write",
      "input": {
        "type": "object",
        "properties": {
          "root": {
            "type": "string",
            "description": "root id; omit for all"
          }
        },
        "required": []
      }
    },
    {
      "name": "library.undo",
      "label": "Undo",
      "description": "Undo one earlier library change, by the undo token that change returned.",
      "scope": "write",
      "input": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          }
        },
        "required": [
          "token"
        ]
      }
    },
    {
      "name": "library.tags",
