        ]
      },
      "shortcut": "E",
      "shows": true
    },
    {
      "name": "photo.favourite",
      "label": "Favourite",
      "description": "Mark photos as favourites, or unmark them.",
      "scope": "write",
      "input": {
        "type": "object",
        "properties": {
          "ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "maxItems": 200,
            "description": "photo ids from library.search (at most 200)"
          },
          "value": {
            "type": "boolean",
            "description": "default true"
          },
          "dryRun": {
            "type": "boolean",
            "description": "report what would change and change nothing"
          }
        },
        "required": [
          "ids"
        ]
      },
      "shortcut": "F"
    },
    {
      "name": "photo.rate",
      "label": "Rate",
      "description": "Give photos a star rating from 0 (none) to 5.",
      "scope": "write",
      "input": {
        "type": "object",
        "properties": {
          "ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "maxItems": 200,
            "description": "photo ids from library.search (at most 200)"
          },
          "rating": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          },
          "dryRun": {
            "type": "boolean",
            "description": "report what would change and change nothing"
          }
        },
        "required": [
          "ids",
          "rating"
        ]
      },
      "shortcut": [
        "0",
        "1",
        "2",
        "3",
        "4",
        "5"
      ]
    },
