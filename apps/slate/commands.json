    {
      "name": "photo.bulk",
      "label": "Change many photos",
      "description": "Apply one change (favourite, rate, flag, tag, hide, album add or remove) to more than 200 photos at once. NakliOS asks the person first, because the change reaches many photos.",
      "scope": "destructive",
      "input": {
        "type": "object",
        "properties": {
          "op": {
            "type": "string",
            "enum": [
              "favourite",
              "rate",
              "flag",
              "tag",
              "hide",
              "album_add",
              "album_remove"
            ]
          },
          "ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "maxItems": 100000,
            "description": "photo ids from library.search (at most 100000)"
          },
          "value": {
            "type": "boolean"
          },
          "rating": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          },
          "flag": {
            "type": "string",
            "enum": [
              "pick",
              "reject",
              "none"
            ]
          },
          "add": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "remove": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "album": {
            "type": "string"
          },
          "dryRun": {
            "type": "boolean",
            "description": "report what would change and change nothing"
          }
        },
        "required": [
          "op",
          "ids"
        ]
      }
    },
