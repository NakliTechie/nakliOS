        ]
      }
    },
    {
      "name": "photo.open",
      "label": "Open in editor",
      "description": "Open one photo in Slate's editor.",
      "scope": "read",
      "input": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          }
        },
        "required": [
