    {
      "name": "photo.trash",
      "label": "Move to trash",
      "description": "Move photos into the trash folder (.slate-trash) inside their library folder. They can be restored until the trash is emptied.",
      "scope": "destructive",
      "input": {
        "type": "object",
        "properties": {
          "ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "maxItems": 5000,
            "description": "photo ids from library.search (at most 5000)"
          },
          "dryRun": {
            "type": "boolean",
            "description": "report what would change and change nothing"
          }
        },
        "required": [
          "ids"
        ]
      },
