    },
    {
      "name": "tool.text",
      "label": "Text",
      "description": "Pick the text tool.",
      "scope": "read",
      "input": {
        "type": "object",
        "properties": {},
        "required": []
      },
      "shortcut": "T"
    },
    {
      "name": "tool.sticky",
      "label": "Sticky note",
      "description": "Pick the sticky note tool.",
      "scope": "read",
      "input": {
        "type": "object",
        "properties": {},
        "required": []
      },
      "shortcut": "S"
    },
    {
      "name": "tool.frame",
      "label": "Frame",
      "description": "Pick the frame tool: drag out a named area that holds what is inside it.",
      "scope": "read",
      "input": {
        "type": "object",
        "properties": {},
        "required": []
      },
      "shortcut": "F"
    },
    {
      "name": "board.read",
      "label": "Read board",
      "description": "Read the board as a compact list: each shape's id, kind, bounds (x, y, w, h), text, frame and group, and for arrows the shape ids they join (from, to). Optional ids or region narrow it.",
      "scope": "read",
      "input": {
        "type": "object",
        "properties": {
          "ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Only these shapes"
          },
          "region": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number",
                "description": "Left"
              },
              "y": {
                "type": "number",
                "description": "Top"
              },
              "w": {
                "type": "number",
                "description": "Width"
              },
              "h": {
                "type": "number",
                "description": "Height"
              }
            },
            "required": [
              "x",
              "y",
              "w",
              "h"
            ]
          }
        },
        "required": []
      }
    },
    {
      "name": "board.snapshot",
      "label": "Snapshot",
      "description": "A PNG of part of the board, for an agent to look at: the shapes `ids`, or a `region` box, or the whole board. maxSize caps the long edge in pixels (default 1024). Returns { dataUrl, width, height, region }.",
      "scope": "read",
      "input": {
        "type": "object",
        "properties": {
          "ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Frame these shapes"
          },
          "region": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number",
                "description": "Left"
              },
              "y": {
                "type": "number",
                "description": "Top"
              },
              "w": {
                "type": "number",
                "description": "Width"
              },
              "h": {
                "type": "number",
                "description": "Height"
              }
            },
            "required": [
              "x",
              "y",
              "w",
              "h"
            ]
          },
          "maxSize": {
            "type": "number",
            "description": "Longest edge in px (default 1024)",
            "minimum": 32,
            "maximum": 4096
          }
        },
        "required": []
      }
    },
    {
      "name": "shape.add",
      "label": "Add shape",
      "description": "Add a shape: kind is rect, ellipse, diamond, triangle, line, arrow, text, sticky, frame, image or ink. Fields: x, y, w, h (board units, 1 = 1 CSS px at 100%), rotation (radians), text, stroke, fill (#rrggbb or transparent), strokeWidth (0–64), dash (solid|dashed|dotted), opacity (0–1), radius (corner radius), sketch (true: hand-drawn look), font (hand|sans|mono), fontSize (px; presets s 16, m 20, l 28, xl 36), align (left|center|right). Kind fields: sticky color (yellow|orange|pink|purple|blue|teal|green|gray); frame name; text autoWidth; line/arrow/ink points [[x,y],…] in board coordinates; arrow route (straight|curved|elbow), bend (curved: -2..2), startHead/endHead (none|arrow|triangle|dot|bar); ink highlight; image fileId. Returns { id }.",
      "scope": "write",
      "input": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "description": "Kind",
            "enum": [
              "rect",
              "ellipse",
              "diamond",
              "triangle",
              "line",
              "arrow",
              "text",
              "sticky",
              "frame",
              "image",
              "ink"
            ]
          },
          "props": {
            "type": "object",
            "description": "Fields (see the description)"
          }
        },
        "required": [
          "kind"
        ]
      }
    },
    {
      "name": "shape.update",
      "label": "Change shapes",
      "description": "Change fields on shapes (default: the selection). Fields: x, y, w, h (board units, 1 = 1 CSS px at 100%), rotation (radians), text, stroke, fill (#rrggbb or transparent), strokeWidth (0–64), dash (solid|dashed|dotted), opacity (0–1), radius (corner radius), sketch (true: hand-drawn look), font (hand|sans|mono), fontSize (px; presets s 16, m 20, l 28, xl 36), align (left|center|right). Kind fields: sticky color (yellow|orange|pink|purple|blue|teal|green|gray); frame name; text autoWidth; line/arrow/ink points [[x,y],…] in board coordinates; arrow route (straight|curved|elbow), bend (curved: -2..2), startHead/endHead (none|arrow|triangle|dot|bar); ink highlight; image fileId.",
      "scope": "write",
      "input": {
        "type": "object",
        "properties": {
          "ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Shape ids (default: the selection)"
          },
          "patch": {
            "type": "object",
            "description": "Fields to change"
          }
        },
        "required": [
          "patch"
        ]
      }
    },
    {
      "name": "shape.delete",
      "label": "Delete",
      "description": "Delete shapes (default: the selection). A frame takes its contents; arrows bound to a deleted shape stay where they were drawn.",
      "scope": "destructive",
      "input": {
        "type": "object",
        "properties": {
          "ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Shape ids (default: the selection)"
          }
        },
        "required": []
      },
      "shortcut": [
        "Delete",
        "Backspace"
      ]
    },
    {
      "name": "shape.move",
      "label": "Move",
      "description": "Move shapes by dx, dy board units. A frame carries its contents; arrows bound to the shapes follow.",
      "scope": "write",
      "input": {
        "type": "object",
        "properties": {
          "ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Shape ids (default: the selection)"
          },
          "dx": {
            "type": "number",
            "description": "Across"
          },
          "dy": {
            "type": "number",
            "description": "Down"
          }
        },
        "required": [
          "dx",
          "dy"
        ]
      }
    },
    {
      "name": "shape.nudge_left",
      "label": "Nudge _left",
      "description": "Move the selection _left by `by` units (default 1; the keyboard uses 10 with Shift).",
      "scope": "write",
      "input": {
        "type": "object",
        "properties": {
          "ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Shape ids (default: the selection)"
          },
          "by": {
            "type": "number",
            "description": "Distance in board units (default 1)"
          }
        },
        "required": []
      },
      "shortcut": [
        "ArrowLeft",
        "Shift+ArrowLeft"
      ]
    },
    {
      "name": "shape.nudge_right",
      "label": "Nudge _right",
      "description": "Move the selection _right by `by` units (default 1; the keyboard uses 10 with Shift).",
      "scope": "write",
      "input": {
        "type": "object",
        "properties": {
          "ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Shape ids (default: the selection)"
          },
          "by": {
            "type": "number",
            "description": "Distance in board units (default 1)"
          }
        },
        "required": []
      },
      "shortcut": [
        "ArrowRight",
        "Shift+ArrowRight"
      ]
    },
    {
      "name": "shape.nudge_up",
      "label": "Nudge _up",
      "description": "Move the selection _up by `by` units (default 1; the keyboard uses 10 with Shift).",
      "scope": "write",
      "input": {
        "type": "object",
        "properties": {
          "ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Shape ids (default: the selection)"
          },
          "by": {
            "type": "number",
            "description": "Distance in board units (default 1)"
          }
        },
        "required": []
      },
      "shortcut": [
        "ArrowUp",
