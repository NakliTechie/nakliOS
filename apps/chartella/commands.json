  "errorCodes": [
    {
      "code": "not-found",
      "meaning": "The shape, frame, file, binding or command named does not exist."
    },
    {
      "code": "locked",
      "meaning": "The shape is locked; unlock it first."
    },
    {
      "code": "empty",
      "meaning": "There is nothing to act on."
    },
    {
      "code": "needs-setup",
      "meaning": "Something must be selected or made first."
    },
    {
      "code": "wrong-kind",
      "meaning": "The operation does not apply to this kind of shape."
    },
    {
      "code": "bad-file",
      "meaning": "The file is not a board Chartella can read."
    },
    {
      "code": "unsupported",
      "meaning": "This browser cannot do it (an API is missing)."
    },
    {
      "code": "bad-colour",
      "meaning": "A colour is not in a form Chartella accepts (#rrggbb, #rgb, #rrggbbaa or transparent)."
    },
    {
      "code": "out-of-range",
      "meaning": "A number is outside its allowed range."
    },
    {
      "code": "bad-value",
      "meaning": "A value is not one of the allowed choices or has the wrong form."
    },
    {
      "code": "refused",
      "meaning": "Any other refusal."
    }
  ]
