      "description": "Bring to front: change the drawing order of shapes.",
      "scope": "write",
      "input": {
        "type": "object",
        "properties": {
          "ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Shape ids (default: the selection)"
          }
        },
