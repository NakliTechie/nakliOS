    },
    {
      "name": "order.back",
      "label": "Send to back",
      "description": "Send to back: change the drawing order of shapes.",
      "scope": "write",
      "input": {
        "type": "object",
        "properties": {
          "ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Shape ids (default: the selection)"
          }
        },
        "required": []
      },
      "shortcut": "Shift+Mod+["
    },
    {
      "name": "group.create",
      "label": "Group",
      "description": "Group two or more shapes so they select and move together. Returns { id } (the group id).",
      "scope": "write",
      "input": {
        "type": "object",
        "properties": {
          "ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Shape ids (default: the selection)"
          }
        },
        "required": []
      },
      "shortcut": "Mod+G"
    },
    {
      "name": "group.remove",
      "label": "Ungroup",
      "description": "Take shapes out of their outermost group.",
      "scope": "write",
      "input": {
        "type": "object",
        "properties": {
          "ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Shape ids (default: the selection)"
          }
        },
        "required": []
      },
      "shortcut": "Shift+Mod+G"
    },
    {
      "name": "arrow.connect",
      "label": "Connect",
      "description": "Draw an arrow from shape `from` to shape `to`, bound at both ends, so it follows them when they move, resize or undo. Optional: route (straight|curved|elbow), startHead/endHead (none|arrow|triangle|dot|bar), text (a label), startAnchor/endAnchor ([ax, ay], fractions of the shape box, to pin an end to a fixed point). Returns { id }.",
      "scope": "write",
      "input": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "description": "Shape id"
          },
          "to": {
            "type": "string",
            "description": "Shape id"
          },
          "route": {
            "type": "string",
            "description": "Route",
            "enum": [
              "straight",
              "curved",
              "elbow"
            ]
          },
          "startHead": {
            "type": "string",
            "description": "Head",
            "enum": [
              "none",
              "arrow",
              "triangle",
              "dot",
              "bar"
            ]
          },
          "endHead": {
            "type": "string",
            "description": "Head",
            "enum": [
              "none",
              "arrow",
              "triangle",
              "dot",
              "bar"
            ]
          },
          "text": {
            "type": "string",
