    {
      "name": "shape.nudge_down",
      "label": "Nudge _down",
      "description": "Move the selection _down by `by` units (default 1; the keyboard uses 10 with Shift).",
      "scope": "write",
      "input": {
        "type": "object",
        "properties": {
          "ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Shape ids (default: the selection)"
          },
          "by": {
            "type": "number",
            "description": "Distance in board units (default 1)"
          }
        },
        "required": []
      },
      "shortcut": [
        "ArrowDown",
        "Shift+ArrowDown"
      ]
    },
    {
      "name": "shape.resize",
      "label": "Resize",
      "description": "Scale shapes so their combined bounds become the box `to` (from defaults to their current bounds). A negative w or h mirrors.",
      "scope": "write",
      "input": {
        "type": "object",
        "properties": {
          "ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Shape ids (default: the selection)"
          },
          "to": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number",
                "description": "Left"
              },
              "y": {
                "type": "number",
                "description": "Top"
              },
              "w": {
                "type": "number",
                "description": "Width"
              },
              "h": {
                "type": "number",
                "description": "Height"
              }
            },
            "required": [
              "x",
              "y",
              "w",
              "h"
            ]
          },
          "from": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number",
                "description": "Left"
              },
              "y": {
                "type": "number",
                "description": "Top"
              },
              "w": {
                "type": "number",
                "description": "Width"
              },
              "h": {
                "type": "number",
                "description": "Height"
              }
            },
            "required": [
              "x",
              "y",
              "w",
              "h"
            ]
          }
        },
        "required": [
          "to"
        ]
      }
    },
    {
      "name": "shape.rotate",
      "label": "Rotate",
      "description": "Rotate shapes by `degrees` (clockwise) about their combined centre or a pivot [x, y].",
      "scope": "write",
      "input": {
        "type": "object",
        "properties": {
          "ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Shape ids (default: the selection)"
          },
          "degrees": {
            "type": "number",
            "description": "Degrees, clockwise"
          },
          "pivot": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2,
            "description": "[x, y]"
          }
        },
        "required": [
          "degrees"
        ]
      }
    },
    {
      "name": "shape.flip_x",
      "label": "Flip horizontal",
      "description": "Mirror shapes left to right about their combined centre.",
      "scope": "write",
      "input": {
        "type": "object",
        "properties": {
          "ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Shape ids (default: the selection)"
          }
        },
        "required": []
      },
      "shortcut": "Shift+H"
    },
    {
      "name": "shape.flip_y",
      "label": "Flip vertical",
      "description": "Mirror shapes top to bottom about their combined centre.",
      "scope": "write",
      "input": {
        "type": "object",
        "properties": {
          "ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Shape ids (default: the selection)"
          }
        },
        "required": []
      },
      "shortcut": "Shift+V"
    },
    {
      "name": "shape.duplicate",
      "label": "Duplicate",
      "description": "Copy shapes (with their arrows between them) 16 units down and right. Returns { ids }.",
      "scope": "write",
      "input": {
        "type": "object",
        "properties": {
          "ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Shape ids (default: the selection)"
          },
          "dx": {
            "type": "number",
            "description": "Offset across (default 16)"
          },
          "dy": {
            "type": "number",
            "description": "Offset down (default 16)"
          }
        },
        "required": []
      },
      "shortcut": "Mod+D"
    },
    {
      "name": "shape.lock",
      "label": "Lock or unlock",
      "description": "Lock shapes (they cannot be selected on the canvas, moved or changed) or unlock them. With no `locked`, toggles.",
      "scope": "write",
      "input": {
        "type": "object",
        "properties": {
          "ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Shape ids (default: the selection)"
          },
          "locked": {
            "type": "boolean",
            "description": "true locks, false unlocks"
          }
        },
        "required": []
      },
      "shortcut": "Shift+Mod+L"
    },
    {
      "name": "shape.align",
      "label": "Align",
      "description": "Align shapes to the edges or centre of their combined bounds: how is left, centerX, right, top, centerY or bottom.",
      "scope": "write",
      "input": {
        "type": "object",
        "properties": {
          "ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Shape ids (default: the selection)"
          },
          "how": {
            "type": "string",
            "description": "How",
            "enum": [
              "left",
              "centerX",
              "right",
              "top",
              "centerY",
              "bottom"
            ]
          }
        },
        "required": [
          "how"
        ]
      }
    },
    {
      "name": "shape.distribute",
      "label": "Distribute",
      "description": "Space three or more shapes evenly across (axis x) or down (axis y).",
      "scope": "write",
      "input": {
        "type": "object",
        "properties": {
          "ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Shape ids (default: the selection)"
          },
          "axis": {
            "type": "string",
            "description": "x or y",
            "enum": [
              "x",
              "y"
            ]
          }
        },
        "required": [
          "axis"
        ]
      }
    },
    {
      "name": "order.forward",
      "label": "Bring forward",
      "description": "Bring forward: change the drawing order of shapes.",
      "scope": "write",
      "input": {
        "type": "object",
        "properties": {
          "ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Shape ids (default: the selection)"
          }
        },
        "required": []
      },
      "shortcut": "Mod+]"
    },
    {
      "name": "order.backward",
      "label": "Send backward",
      "description": "Send backward: change the drawing order of shapes.",
      "scope": "write",
      "input": {
        "type": "object",
        "properties": {
          "ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Shape ids (default: the selection)"
          }
